                    <mxGeometry x="365" y="610" width="210" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="fl_black" value="Color == BLACK&lt;br&gt;Modbus Write: M10 = ON&lt;br&gt;-&gt; PLC triggers Y1 (Cylinder 1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6E6E6;strokeColor=#333333;fontStyle=1;" vertex="1" parent="1">
                    <mxGeometry x="80" y="740" width="230" height="75" as="geometry"/>
                </mxCell>
