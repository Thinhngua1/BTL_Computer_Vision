                </mxCell>
                <mxCell id="fl_white" value="Color == WHITE (or Unknown)&lt;br&gt;Modbus Write: M12 = ON&lt;br&gt;-&gt; Y1=OFF, Y2=OFF (Pass straight)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1">
